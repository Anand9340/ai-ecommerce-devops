pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Validate Project') {
            steps {
                sh '''
                    set -eu

                    test -f docker/Dockerfile
                    test -f docker/docker-compose.yml
                    test -f application/index.html

                    bash -n scripts/setup.sh
                    bash -n scripts/deploy.sh
                    bash -n scripts/health-check.sh
                    bash -n scripts/backup.sh
                    bash -n scripts/cleanup.sh

                    docker compose -f docker/docker-compose.yml config -q

                    echo "Project validation passed."
                '''
            }
        }

        stage('Secret Scan') {
            steps {
                sh '''
                    set -eu
                    gitleaks detect \
                      --source . \
                      --redact \
                      --exit-code 1

                    echo "Secret scan passed."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -f docker/Dockerfile \
                      -t nexvion-ecommerce:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      --no-progress \
                      nexvion-ecommerce:${BUILD_NUMBER}
                '''
            }
        }

        stage('Container Smoke Test') {
            steps {
                sh '''
                    set -eu

                    CONTAINER="nexvion-ci-test-${BUILD_NUMBER}"
                    IMAGE="nexvion-ecommerce:${BUILD_NUMBER}"

                    cleanup() {
                        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
                    }
                    trap cleanup EXIT

                    docker run -d \
                      --name "$CONTAINER" \
                      -p 127.0.0.1:18080:80 \
                      "$IMAGE"

                    ATTEMPT=0
                    until curl -fsS http://127.0.0.1:18080/ >/dev/null; do
                        ATTEMPT=$((ATTEMPT + 1))
                        if [ "$ATTEMPT" -ge 10 ]; then
                            echo "Container smoke test failed."
                            docker logs "$CONTAINER"
                            exit 1
                        fi
                        sleep 2
                    done

                    echo "Container smoke test passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'Validation, image build and smoke test passed.'
        }
        failure {
            echo 'Pipeline failed. Review the failed stage logs.'
        }
    }
}
